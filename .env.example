# Copy to .env and fill in. Never commit the real .env.
#
# JWT_SECRET is required: a Base64-encoded random key of at least 256 bits.
# Generate one with:   openssl rand -base64 48
# (left empty on purpose: docker compose refuses to start until you set it)
JWT_SECRET=
POSTGRES_PASSWORD=applytrack
# true = create the demo account (demo@applytrack.dev / demo1234) on first start.
# Keep it false for anything reachable from the internet.
SEED_DEMO_DATA=false
